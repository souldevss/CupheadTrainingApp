<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>CupheadTrainingApp</RootNamespace>
    <AssemblyName>CupheadTrainingApp</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>App.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en;pt-BR</SatelliteResourceLanguages>
    <Version>1.3.2</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup Condition="'$(DeveloperBuild)' == 'true'">
    <DefineConstants>$(DefineConstants);DEVELOPER_BUILD</DefineConstants>
    <AssemblyName>CupheadTrainingApp.Developer</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="artifacts\**\*.cs" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="scripts\ApplyUpdate.ps1" LogicalName="ApplyUpdate.ps1" />
    <EmbeddedResource Include="scripts\DeveloperRanks.js" LogicalName="DeveloperRanks.js"
                      Condition="'$(DeveloperBuild)' == 'true'" />
    <Content Include="Web\**\*" Exclude="Web\README.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <Target Name="ExcludeWpfRuntimeAssets"
          AfterTargets="ResolveRuntimePackAssets"
          Condition="'$(SelfContained)' == 'true' And '$(UseWPF)' != 'true'">
    <ItemGroup>
      <!-- The Windows Desktop runtime pack includes WPF even for Windows Forms apps. -->
      <_UnusedWpfRuntimeAsset Include="@(RuntimePackAsset)"
          Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(RuntimePackAsset.Filename)', '^(PresentationCore|PresentationFramework(?:[.-].*)?|PresentationUI|ReachFramework|System\.Printing|System\.Windows\.(Controls\.Ribbon|Input\.Manipulations|Presentation)|UIAutomationClient(?:SideProviders)?|WindowsFormsIntegration)(\.resources)?$'))" />
      <_UnusedWpfRuntimeAsset Include="@(RuntimePackAsset)"
          Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(RuntimePackAsset.Filename)', '^(D3DCompiler_47_cor3|PenImc_cor3|PresentationNative_cor3|wpfgfx_cor3)$'))" />
      <RuntimePackAsset Remove="@(_UnusedWpfRuntimeAsset)" />
      <ReferenceCopyLocalPaths Remove="@(_UnusedWpfRuntimeAsset)" />
    </ItemGroup>
  </Target>
  <Target Name="ExcludeWebViewWpfReference"
          BeforeTargets="ResolveAssemblyReferences"
          Condition="'$(UseWPF)' != 'true'">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Reference.Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>
</Project>
